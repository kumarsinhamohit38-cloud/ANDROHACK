# ── Optional: Override embedding model ────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Dataset sizes ─────────────────────────────────────────────────────────────
# DEMO_SIZE=10000
# FULL_DATASET_SIZE=100000

# ── Retrieval parameters ──────────────────────────────────────────────────────
# DENSE_TOP_K=20
# BM25_TOP_K=20
# FINAL_TOP_K=5
# RRF_K=60

# ── Batch size for embedding ──────────────────────────────────────────────────
# BATCH_SIZE=64

# ── ChromaDB collection name ──────────────────────────────────────────────────
# CHROMA_COLLECTION=ms_marco_passages

# ── Benchmark settings ────────────────────────────────────────────────────────
# BENCHMARK_QUERIES=50
